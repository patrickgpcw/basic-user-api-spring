DB_USERNAME=basic_user
DB_PASSWORD=change-me-local
# Replace with a random value of at least 32 bytes (e.g. openssl rand -hex 32).
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Optional local ports (container ports remain unchanged).
APP_PORT=8080
DB_PORT=5432

# Login limits per application instance.
LOGIN_IP_LIMIT=30
LOGIN_ACCOUNT_LIMIT=5
LOGIN_WINDOW=PT1M
LOGIN_MAX_ENTRIES=10000
